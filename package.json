        "check": "ultracite check",
        "fix": "ultracite fix"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "bumpp": "^11.1.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "tsdown": "^0.22.5",
        "typescript": "6.0.3",
        "ultracite": "7.10.3",
        "vitest": "^4.1.10"
    }
}
